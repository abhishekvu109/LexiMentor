# Copy to .env and fill in your values

# MySQL — same database as fitmate-service
DB_HOST=localhost
DB_PORT=3306
DB_NAME=abhishek
DB_USER=abhishek
DB_PASSWORD=your_password_here

# MLflow experiment tracking server  (start with: mlflow ui)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fitmate-recommendation

# Directory where trained model .pkl files are saved
MODEL_DIR=./artefacts

# App
APP_ENV=development
LOG_LEVEL=INFO
